FROM node:22-trixie-slim@sha256:9ae0ccefe9959b44ae8325ba2099ec77d670e8edfce3770d364d425fc1df7d87 AS base
WORKDIR /opt/nexa

FROM base AS build
RUN chown node:node /opt/nexa && corepack enable
COPY --chown=node:node . .
USER node
ENV NEXT_TELEMETRY_DISABLED=1 HUSKY=0
RUN yarn install --immutable

ARG NEXT_PUBLIC_API_URL
ARG API_PROXY_TARGET
ENV NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    API_PROXY_TARGET=${API_PROXY_TARGET} \
    NEXT_PUBLIC_DEMO_MODE=false
RUN node -e 'const match = /^https:\/\/nexa-stg-api\.internal\.([a-z0-9-]+\.malaysiawest\.azurecontainerapps\.io)$/.exec(process.env.API_PROXY_TARGET); if (!match || process.env.NEXT_PUBLIC_API_URL !== "https://nexa-stg-web." + match[1]) process.exit(1)' \
    && yarn workspace next-app build \
    && yarn cache clean

FROM base AS runtime
ARG NEXT_PUBLIC_API_URL
ARG API_PROXY_TARGET
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_API_URL=${NEXT_PUBLIC_API_URL} \
    API_PROXY_TARGET=${API_PROXY_TARGET} \
    NEXT_PUBLIC_DEMO_MODE=false \
    PORT=3000 \
    HOSTNAME=0.0.0.0
COPY --from=build --chown=node:node /opt/nexa/apps/next/.next/standalone /opt/nexa/
COPY --from=build --chown=node:node /opt/nexa/apps/next/.next/static /opt/nexa/apps/next/.next/static
COPY --from=build --chown=node:node /opt/nexa/apps/next/public /opt/nexa/apps/next/public
RUN apt-get update && apt-get upgrade -y && rm -rf /var/lib/apt/lists/* \
    && rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack
USER node
EXPOSE 3000
CMD ["node", "/opt/nexa/apps/next/server.js"]
