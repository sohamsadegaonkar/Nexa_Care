{
  "family": "nexa-care-pilot-api",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],

  "cpu": "<TASK_CPU>",
  "memory": "<TASK_MEMORY>",

  "executionRoleArn": "<ECS_EXECUTION_ROLE_ARN>",
  "taskRoleArn": "<ECS_TASK_ROLE_ARN>",

  "containerDefinitions": [
    {
      "name": "nexa-care-pilot-api",

      "image": "<QUALIFIED_ECR_IMAGE_URI_BY_DIGEST>",

      "essential": true,

      "portMappings": [
        {
          "containerPort": 8000,
          "hostPort": 8000,
          "protocol": "tcp"
        }
      ],

      "environment": [
        {
          "name": "ENVIRONMENT",
          "value": "pilot"
        },
        {
          "name": "PORT",
          "value": "8000"
        },

        {
          "name": "DOCUMENT_EXTRACTION_PROVIDER",
          "value": "aws_textract"
        },
        {
          "name": "DOCUMENT_AI_AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "DOCUMENT_AI_TIMEOUT_SECONDS",
          "value": "30"
        },
        {
          "name": "DOCUMENT_AI_MAX_ATTEMPTS",
          "value": "3"
        },
        {
          "name": "DOCUMENT_AI_PROVIDER_MAX_ATTEMPTS",
          "value": "3"
        },
        {
          "name": "DOCUMENT_AI_JOB_MAX_ATTEMPTS",
          "value": "3"
        },
        {
          "name": "DOCUMENT_AI_ASYNC_MULTIPAGE_ENABLED",
          "value": "false"
        },

        {
          "name": "DOCUMENT_STORAGE_PROVIDER",
          "value": "s3"
        },
        {
          "name": "DOCUMENT_STORAGE_S3_BUCKET",
          "value": "<DOCUMENT_STORAGE_S3_BUCKET>"
        },
        {
          "name": "DOCUMENT_STORAGE_S3_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "DOCUMENT_STORAGE_S3_KMS_KEY_ID",
          "value": "<DOCUMENT_STORAGE_S3_KMS_KEY_ID>"
        },

        {
          "name": "ENCRYPTION_BACKEND",
          "value": "kms"
        },
        {
          "name": "AWS_REGION",
          "value": "ap-south-1"
        },
        {
          "name": "KMS_KEY_ID",
          "value": "<APPLICATION_ENVELOPE_KMS_KEY_ID>"
        },
        {
          "name": "AWS_PATIENT_SPECIFIC_KMS_KEYS",
          "value": "false"
        },

        {
          "name": "CORS_ALLOWED_ORIGINS",
          "value": "<FINAL_DOCTOR_HTTPS_ORIGIN>"
        },
        {
          "name": "TRUSTED_HOSTS",
          "value": "<FINAL_API_HOST>"
        },
        {
          "name": "TRUSTED_PROXY_NETWORKS",
          "value": "<FINAL_TRUSTED_PROXY_CIDRS>"
        },
        {
          "name": "FORWARDED_ALLOW_IPS",
          "value": "<FINAL_FORWARDED_PROXY_CIDRS>"
        },

        {
          "name": "PUSH_STATUS_TRANSPORT",
          "value": "poll"
        },
        {
          "name": "AUTO_COMMIT",
          "value": "false"
        },
        {
          "name": "DATABASE_ECHO_SQL",
          "value": "false"
        }
      ],

      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "<DATABASE_URL_SECRET_REFERENCE>"
        },
        {
          "name": "UPSTASH_REDIS_URL",
          "valueFrom": "<REDIS_URL_SECRET_REFERENCE>"
        },

        {
          "name": "SUPABASE_URL",
          "valueFrom": "<SUPABASE_URL_SECRET_REFERENCE>"
        },
        {
          "name": "SUPABASE_KEY",
          "valueFrom": "<SUPABASE_KEY_SECRET_REFERENCE>"
        },

        {
          "name": "DOCUMENT_STORAGE_ENCRYPTION_KEY",
          "valueFrom": "<DOCUMENT_STORAGE_ENCRYPTION_KEY_SECRET_REFERENCE>"
        },

        {
          "name": "HANDSHAKE_PEPPER_SECRET",
          "valueFrom": "<HANDSHAKE_PEPPER_SECRET_REFERENCE>"
        },
        {
          "name": "MFA_ENCRYPTION_KEY",
          "valueFrom": "<MFA_ENCRYPTION_KEY_SECRET_REFERENCE>"
        },
        {
          "name": "PII_ENCRYPTION_KEY",
          "valueFrom": "<PII_ENCRYPTION_KEY_SECRET_REFERENCE>"
        },
        {
          "name": "PATIENT_JWT_SECRET",
          "valueFrom": "<PATIENT_JWT_SECRET_REFERENCE>"
        },
        {
          "name": "OTP_RATE_LIMIT_HMAC_SECRET",
          "valueFrom": "<OTP_RATE_LIMIT_HMAC_SECRET_REFERENCE>"
        }
      ],

      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "<CLOUDWATCH_LOG_GROUP>",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      },

      "healthCheck": {
        "command": [
          "CMD-SHELL",
          "python -c \"import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/healthz', timeout=5).read()\" || exit 1"
        ],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 30
      }
    }
  ]
}
