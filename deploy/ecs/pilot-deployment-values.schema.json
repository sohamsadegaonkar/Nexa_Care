{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nexa Care AWS pilot activation values",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "AWS_REGION": {
      "const": "ap-south-1"
    },
    "ROLE_ARN": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "ECS_CLUSTER": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,255}$"
    },
    "ECS_SERVICE": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{1,255}$"
    },
    "ECR_REPOSITORY": {
      "type": "string",
      "minLength": 2
    },
    "CLAMD_ECR_REPOSITORY": {
      "type": "string",
      "minLength": 2
    },
    "API_IMAGE_DIGEST": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "CLAMD_IMAGE_DIGEST": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "RUNTIME_SECRET_ID": {
      "type": "string",
      "minLength": 1
    },
    "DOCUMENT_STORAGE_SECRET_ID": {
      "type": "string",
      "minLength": 1
    },
    "API_BASE_URL": {
      "type": "string",
      "pattern": "^https://"
    },
    "TASK_CPU": {
      "const": "1024"
    },
    "TASK_MEMORY": {
      "const": "3072"
    },
    "ECS_EXECUTION_ROLE_ARN": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "ECS_TASK_ROLE_ARN": {
      "type": "string",
      "pattern": "^arn:aws:iam::[0-9]{12}:role/[A-Za-z0-9+=,.@_/-]+$"
    },
    "QUALIFIED_ECR_IMAGE_URI_BY_DIGEST": {
      "type": "string",
      "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-south-1\\.amazonaws\\.com/.+@sha256:[0-9a-f]{64}$"
    },
    "QUALIFIED_CLAMD_IMAGE_URI_BY_DIGEST": {
      "type": "string",
      "pattern": "^[0-9]{12}\\.dkr\\.ecr\\.ap-south-1\\.amazonaws\\.com/.+@sha256:[0-9a-f]{64}$"
    },
    "DOCUMENT_STORAGE_S3_BUCKET": {
      "type": "string",
      "minLength": 3
    },
    "DOCUMENT_STORAGE_S3_KMS_KEY_ID": {
      "type": "string",
      "minLength": 1
    },
    "APPLICATION_ENVELOPE_KMS_KEY_ID": {
      "type": "string",
      "minLength": 1
    },
    "CLOUDWATCH_LOG_GROUP": {
      "type": "string",
      "minLength": 1
    },
    "DATABASE_URL_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "REDIS_URL_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "SUPABASE_URL_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "SUPABASE_KEY_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "DOCUMENT_STORAGE_ENCRYPTION_KEY_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "HANDSHAKE_PEPPER_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "MFA_ENCRYPTION_KEY_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "PII_ENCRYPTION_KEY_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "PATIENT_JWT_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "OTP_RATE_LIMIT_HMAC_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "PROVIDER_REGISTRATION_IDEMPOTENCY_HMAC_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "PROVIDER_CONTACT_ASSURANCE_HMAC_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "PATIENT_GRANT_REFERENCE_HMAC_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "OPERATIONS_AUTH_TOKEN_SECRET_REFERENCE": {
      "$ref": "#/$defs/secretArn"
    },
    "FINAL_API_HOST": {
      "type": "string",
      "minLength": 1
    },
    "FINAL_DOCTOR_HTTPS_ORIGIN": {
      "type": "string",
      "pattern": "^https://"
    },
    "FINAL_TRUSTED_PROXY_CIDRS": {
      "type": "string",
      "minLength": 1
    },
    "FINAL_FORWARDED_PROXY_CIDRS": {
      "type": "string",
      "minLength": 1
    },
    "MEDICATION_CATALOG_SIGNING_KEY_ID": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "secretArn": {
      "type": "string",
      "pattern": "^arn:aws:secretsmanager:ap-south-1:[0-9]{12}:secret:"
    }
  },
  "required": [
    "AWS_REGION",
    "ROLE_ARN",
    "ECS_CLUSTER",
    "ECS_SERVICE",
    "ECR_REPOSITORY",
    "CLAMD_ECR_REPOSITORY",
    "API_IMAGE_DIGEST",
    "CLAMD_IMAGE_DIGEST",
    "RUNTIME_SECRET_ID",
    "DOCUMENT_STORAGE_SECRET_ID",
    "API_BASE_URL",
    "TASK_CPU",
    "TASK_MEMORY",
    "ECS_EXECUTION_ROLE_ARN",
    "ECS_TASK_ROLE_ARN",
    "QUALIFIED_ECR_IMAGE_URI_BY_DIGEST",
    "QUALIFIED_CLAMD_IMAGE_URI_BY_DIGEST",
    "DOCUMENT_STORAGE_S3_BUCKET",
    "DOCUMENT_STORAGE_S3_KMS_KEY_ID",
    "APPLICATION_ENVELOPE_KMS_KEY_ID",
    "MEDICATION_CATALOG_SIGNING_KEY_ID",
    "CLOUDWATCH_LOG_GROUP",
    "DATABASE_URL_SECRET_REFERENCE",
    "REDIS_URL_SECRET_REFERENCE",
    "SUPABASE_URL_SECRET_REFERENCE",
    "SUPABASE_KEY_SECRET_REFERENCE",
    "DOCUMENT_STORAGE_ENCRYPTION_KEY_SECRET_REFERENCE",
    "HANDSHAKE_PEPPER_SECRET_REFERENCE",
    "MFA_ENCRYPTION_KEY_SECRET_REFERENCE",
    "PII_ENCRYPTION_KEY_SECRET_REFERENCE",
    "PATIENT_JWT_SECRET_REFERENCE",
    "OTP_RATE_LIMIT_HMAC_SECRET_REFERENCE",
    "PROVIDER_REGISTRATION_IDEMPOTENCY_HMAC_SECRET_REFERENCE",
    "PROVIDER_CONTACT_ASSURANCE_HMAC_SECRET_REFERENCE",
    "PATIENT_GRANT_REFERENCE_HMAC_SECRET_REFERENCE",
    "OPERATIONS_AUTH_TOKEN_SECRET_REFERENCE",
    "FINAL_API_HOST",
    "FINAL_DOCTOR_HTTPS_ORIGIN",
    "FINAL_TRUSTED_PROXY_CIDRS",
    "FINAL_FORWARDED_PROXY_CIDRS"
  ]
}
