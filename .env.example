# Nexa Care environment template (UTF-8).
# Copy to .env.alpha, fill it locally, then copy to .env for Python runtime use.
# Never commit real credentials. Supabase requires the backend service-role key.

# Required runtime configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key
# Async SQLAlchemy URL; the postgresql+asyncpg driver is required.
DATABASE_URL=postgresql+asyncpg://username:password@host:5432/database
# Hosted Upstash normally requires TLS: rediss://default:token@host:6379
UPSTASH_REDIS_URL=rediss://default:token@host:6379
HANDSHAKE_PEPPER_SECRET=<GENERATE_IN_SECRET_MANAGER>
KEK_ROOT_SECRET=<GENERATE_IN_SECRET_MANAGER>
# Fernet keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=<GENERATE_FERNET_KEY>
PII_ENCRYPTION_KEY=<GENERATE_FERNET_KEY>
PATIENT_JWT_SECRET=<GENERATE_IN_SECRET_MANAGER>
OTP_RATE_LIMIT_HMAC_SECRET=<GENERATE_IN_SECRET_MANAGER>

# Deprecated and script-only; provider routes do not use this credential.
CLINIC_API_KEY=GENERATED_LEGACY_SCRIPT_KEY
# Required only when running scripts/seed_demo_doctor.py.
DEMO_PROVIDER_PASSWORD=<SET_IN_IGNORED_LOCAL_ENV>
TEST_PROVIDER_PASSWORD=<SET_IN_TEST_ENVIRONMENT>

# Optional configuration
ENV=development
ENCRYPTION_BACKEND=local
DATABASE_ECHO_SQL=false
MAX_UPLOAD_BYTES=20971520
PUSH_STATUS_TRANSPORT=poll
DOCUMENT_AI_API_KEY=
DOCUMENT_AI_API_URL=
CORS_ALLOWED_ORIGINS=
# Local alpha/test only. Deployed environments must list deployment domains.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Expo mobile build variables. Configure deployed preview/production values in
# EAS environment variables, not in this backend file. A developer may copy
# these into the ignored nexa-client/apps/expo/.env for a local device build.
EXPO_PUBLIC_API_URL=https://api-alpha.example.com
EXPO_PUBLIC_APP_ENV=development
# Set true only for an intentional development build targeting an HTTP LAN URL.
EXPO_PUBLIC_ALLOW_HTTP=false
# Expo/Firebase values belong in ignored local files or EAS environments.
EXPO_PUBLIC_EAS_PROJECT_ID=<SET_PER_EAS_PROJECT>
GOOGLE_SERVICES_FILE=<EAS_FILE_SECRET_OR_IGNORED_LOCAL_PATH>
# Optional provider-email prefill only; passwords are never prefilled.
NEXT_PUBLIC_DEMO_MODE=false

# Generate every random secret independently; never reuse values:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
