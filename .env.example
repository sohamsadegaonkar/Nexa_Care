# Nexa Care — example environment variables.
# Copy this file to .env and fill in the real values.
# DO NOT commit the real .env file.

# ── Supabase (backend data store) ───────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-service-role-key

# ── Async Postgres (provider layer, SQLAlchemy + asyncpg) ───────────────────
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/nexa_care

# ── Redis / Upstash (live sessions, consent tokens, provider sessions) ──────
UPSTASH_REDIS_URL=redis://localhost:6379

# ── Biometric HMAC pepper (must be rotated with great care) ──────────────────
HANDSHAKE_PEPPER_SECRET=change-me-to-a-long-random-string

# ── Document AI (optional; falls back to mock extraction if absent) ─────────
DOCUMENT_AI_API_KEY=

# ── Encryption keys (at-rest Fernet keys, base64-encoded 32-byte values) ───
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=change-me-to-a-fernet-key-32-bytes-b64==
PII_ENCRYPTION_KEY=change-me-to-a-fernet-key-32-bytes-b64==

# ── Legacy script-only credential (deprecated; do not use for provider routes)
CLINIC_API_KEY=legacy-script-only-key

# ── Optional: echo SQL statements for debugging ─────────────────────────────
DATABASE_ECHO_SQL=false

# ── Optional: allowed CORS origins (comma-separated; omit for no CORS) ──────
# CORS_ALLOWED_ORIGINS=https://your-frontend.com,https://admin.your-frontend.com

# ── Optional: trusted Host headers (comma-separated; default is '*' for dev) ─
# TRUSTED_HOSTS=api.nexa.care,admin.nexa.care
